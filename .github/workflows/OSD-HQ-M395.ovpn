remote-cert-eku "TLS Web Server Authentication"
remote 58.82.186.50 51313
remote 103.197.244.50 51313
persist-key
persist-tun
verb 3
mute 20
keepalive 10 60
cipher AES-256-CBC
# OpenVPN 2.5+ (incl. 2.6) negotiates data channel ciphers via --data-ciphers.
# The server is requesting AES-256-CBC, so we must allow it here.
data-ciphers AES-256-GCM:AES-128-GCM:CHACHA20-POLY1305:AES-256-CBC
data-ciphers-fallback AES-256-CBC
auth SHA256
float
reneg-sec 28800
nobind
mute-replay-warnings
auth-user-pass
tls-version-min 1.2
;remember_connection 0
;auto_reconnect 1
