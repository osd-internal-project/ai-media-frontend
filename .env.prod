NEXT_PUBLIC_API_BASE_URL_USER=https://www.aicave.ai/public/api/v1/user
NEXT_PUBLIC_API_BASE_URL_REPORT=https://www.aicave.ai/public/api/v1/report
NEXT_PUBLIC_API_BASE_URL_CORE=https://www.aicave.ai/public/api/v1/core
NEXT_PUBLIC_API_BASE_URL_WORKER=https://www.aicave.ai/public/api/v1/worker
NEXT_PUBLIC_API_BASE_URL_CHAT_ASSISTANT=https://www.aicave.ai/public/api/v1/chat-assistant
NEXT_PUBLIC_API_BASE_URL_WEB_HOOK=https://www.aicave.ai
# Omise publishable key (public by design — inlined into the client bundle at build time).
# ⚠️ PROD must use the LIVE key (pkey_...), NOT a test key, and match the backend's live OMISE_SECRET_KEY.
NEXT_PUBLIC_OMISE_PUBLIC_KEY=pkey_REPLACE_WITH_LIVE_PUBLISHABLE_KEY
